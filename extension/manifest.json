{
  "manifest_version": 3,
  "name": "FocusOn Meeting Intelligence (FOI-MeetAI)",
  "short_name": "FOI-MeetAI",
  "version": "1.0.0",
  "description": "Records client meetings (Google Meet / Zoom / Teams), transcribes, and auto-generates verified Minutes of Meeting into Google Sheets for FocusOn Interiors.",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FOI-MeetAI Meeting Assistant"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "alarms",
    "notifications",
    "identity",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/platform-base.js", "content/adapters/meetAdapter.js", "content/content-main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zoom.us/*"],
      "js": ["content/platform-base.js", "content/adapters/zoomAdapter.js", "content/content-main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["content/platform-base.js", "content/adapters/teamsAdapter.js", "content/content-main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [],
  "oauth2": {
    "client_id": "PASTE_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/gmail.compose",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
