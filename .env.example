# =============================================================================
# FocusOn AI — environment template. EVERYTHING here is optional individually;
# the system works with whichever subset you provide (per-provider fallback).
# Copy to .env.local for local dev, or set these in Vercel project settings.
# =============================================================================

# --- Supabase (optional: meeting history, provider health, key vault, ERP) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Security (recommended for a public deployment) ---
# Shared secret the Chrome extension must send as Authorization: Bearer <token>.
# If unset, the meeting API runs in open-workspace mode (fine for private use).
MEETAI_API_TOKEN=
# Random 32+ char secret enabling the encrypted server-side API-key vault.
KEY_VAULT_SECRET=

# --- Speech-to-Text providers (any ONE works; more = more reliability) ---
# Groq: shares the key with the LLM chain. Free tier, very fast.
GROQ_API_KEY=your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Deepgram: free tier + paid; built-in speaker diarization.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# AssemblyAI: free tier; diarization + Hindi detection.
ASSEMBLYAI_API_KEY=
# OpenAI Whisper: paid, high accuracy. Shares OPENAI_API_KEY with the LLM chain.
OPENAI_WHISPER_MODEL=whisper-1
# Google Cloud Speech-to-Text: API key with hi-IN/en-IN support.
GOOGLE_STT_API_KEY=
# Local whisper.cpp / OpenAI-compatible self-hosted STT endpoint (base URL).
LOCAL_WHISPER_URL=
LOCAL_WHISPER_MODEL=whisper-1

# --- LLM providers (MOM extraction + verification) ---
# Google Gemini: generous free tier; also powers screenshot tagging.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq LLM (same GROQ_API_KEY as above).
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter: one key -> many free+paid models (wide safety net).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Anthropic Claude: paid; preferred engine for the accuracy-verification pass.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# OpenAI GPT-4o / GPT-4o-mini: paid.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# DeepSeek: very cheap paid fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Self-hosted Ollama (OpenAI-compatible /v1/chat/completions): final offline fallback.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
